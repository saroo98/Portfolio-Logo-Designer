{
  "name": "maryam-ansari-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Maryam Ansari — Logo Designer. Static portfolio site with Playwright + axe + Lighthouse test suite.",
  "type": "commonjs",
  "scripts": {
    "start": "http-server . -p 4173 -c-1",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lighthouse http://localhost:4173 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=./lighthouse.json --chrome-flags=\"--headless\" --quiet"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "http-server": "^14.1.1",
    "lighthouse": "^13.3.0"
  },
  "license": "UNLICENSED"
}
